<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd">
  <display-name>SisImagem</display-name>
  <context-param>
    <param-name>path</param-name>
   <!-- <param-value>c:\\trim\\</param-value> -->
    <param-value>/repositorio/</param-value>
  </context-param>
  
  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>
  
  <servlet>
    <servlet-name>Controlador</servlet-name>
    <servlet-class>controller.ServletControlador</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>Controlador</servlet-name>
    <url-pattern>/controller/controlador</url-pattern>
  </servlet-mapping>
  <servlet>
    
    <display-name>AbrirDoc</display-name>
    <servlet-name>AbrirDoc</servlet-name>
    <servlet-class>controller.OperacaoAbrirDocumento</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AbrirDoc</servlet-name>
    <url-pattern>/controller/AbrirDoc</url-pattern>
  </servlet-mapping>
  <servlet>
    
    <display-name>ScanearDoc</display-name>
    <servlet-name>ScanearDoc</servlet-name>
    <servlet-class>controller.OperacaoScanearDocumento</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ScanearDoc</servlet-name>
    <url-pattern>/controller/scanearDocumento</url-pattern>
  </servlet-mapping>
     <filter-mapping>
    <filter-name>LoginFilter</filter-name>
    <url-pattern>/views/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
     </filter-mapping>
    
  <filter>
    <display-name>Tela Inicial do Sistema</display-name>
    <filter-name>LoginFilter</filter-name>
    <filter-class>utilitaria.LoginFilter</filter-class>
  </filter>
 
  <servlet>
    <description></description>
    <display-name>ChamaScaner</display-name>
    <servlet-name>ChamaScaner</servlet-name>
    <servlet-class>controller.ChamaScaner</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ChamaScaner</servlet-name>
    <url-pattern>/ChamaScaner</url-pattern>
  </servlet-mapping>

        
